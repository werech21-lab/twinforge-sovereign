NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# يجب أن تطابق كلمة مرور صفحة /admin/activate
ADMIN_ACTIVATE_KEY=twinforge2026

# AI providers (أول متوفر يُستخدم: Gemini ثم OpenAI ثم Anthropic ثم Perplexity)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
AI_TASK_COST_CAP_USD=0.10

# خدمات الوكيل الخارجية الأربعة (TwinForge Agent Tools)
# 1. Perplexity (تحليل أسواق المطاعم والأعمال في الكويت والخليج)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# 2. Firecrawl (سحب قوائم الطعام وأسعار المنافسين بالدينار الكويتي KWD)
FIRECRAWL_API_KEY=

# 3. Playwright (يعمل محلياً عبر Chromium/Edge/Chrome أو سحابياً عبر نقطة WebSocket/CDP)
PLAYWRIGHT_WS_ENDPOINT=

# 4. Composio (تنفيذ إجراءات Gmail و Google Sheets و Slack عبر Claude)
COMPOSIO_API_KEY=
COMPOSIO_CONNECTED_ACCOUNT_ID=
COMPOSIO_ENTITY_ID=
